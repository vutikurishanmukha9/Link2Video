# Application Environment (development, staging, production)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Neon PostgreSQL Database Connection URL (Async)
# Local fallback: sqlite+aiosqlite:///./dev.db
# Neon Production: postgresql+asyncpg://user:password@ep-xyz-pooler.region.neon.tech/neondb?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Upstash Redis Connection (for Caching & Rate Limiting)
# Upstash URI: rediss://default:password@xyz.upstash.io:6379
# Leave empty for automatic in-memory cache/rate-limiter during local dev
REDIS_URL=

# Allowed Frontend Origins for CORS
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_ANALYZE=10
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_TTL_SECONDS=600

# Optional Upstream Platform API Keys (if using third-party scrapers/APIs)
INSTAGRAM_API_KEY=
TWITTER_API_KEY=
